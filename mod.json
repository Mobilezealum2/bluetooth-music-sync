{
  "geode": "5 9.0",
  "gd": {
    "win": "2.2081",
    "android": "2.2081"
  },
  "id": "yourname.music-sync",
  "name": "Music Sync",
  "version": "v1.1.0",
  "developer": "yourname",
  "description": "Синхронизирует музыку с игрой при лагах, режим задержки для Bluetooth",
  "settings": {
    "threshold": {
      "type": "int",
      "name": "Порог рассинхрона (мс)",
      "default": 40,
      "min": 15,
      "max": 300
    },
    "bt_enabled": {
      "type": "bool",
      "name": "Режим Bluetooth",
      "default": false
    },
    "bt_delay": {
      "type": "int",
      "name": "Задержка наушников (мс)",
      "default": 150,
      "min": 0,
      "max": 500
    }
  }
}
